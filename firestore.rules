rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Looks up the CALLER's own users/{uid} doc to check isAdmin. This is
    // the only privilege check in the whole ruleset: a client can never
    // set isAdmin on itself (see the create rule below), so the only way
    // this is ever true is if another admin, or the project owner via the
    // Firebase console, set it.
    function callerIsAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // A caller must be an *approved* member (not just signed in) before
    // they can create/edit a profile, or read the directory — this is the
    // authoritative check; ProtectedRoute in the app is only a UX
    // convenience on top of it.
    function callerIsApproved() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // Directory reads (Phase 3) additionally check that the PROFILE
    // OWNER is still approved, not just the caller. This covers the edge
    // case where an admin later revokes an already-approved member: their
    // profile doc keeps existing (profiles are never auto-deleted), so
    // without this check it would stay directory-visible after the
    // revocation. This costs one extra document read per profile
    // returned — acceptable at this alumni-network's scale; if the
    // member base grows large enough for this to matter, a Cloud
    // Function that denormalizes approval status onto the profile at
    // write time would remove the extra read (that's a "stop and
    // explain" architecture change per CLAUDE.md section 6/14, not done
    // here).
    function profileOwnerIsApproved(ownerUid) {
      return exists(/databases/$(database)/documents/users/$(ownerUid))
        && get(/databases/$(database)/documents/users/$(ownerUid)).data.status == 'approved';
    }

    // Keep this ceiling in sync with CURRENT_MAX_BATCH_NUMBER in
    // src/lib/batches.ts. null is allowed (batch not yet selected).
    function isValidBatchNumber(n) {
      return n == null || (n is int && n >= 1 && n <= 43);
    }

    function isValidProfileShape(data) {
      return data.displayName is string && data.displayName.size() <= 200
        && data.displayNameLower is string && data.displayNameLower == data.displayName.lower()
        && (data.photoURL == null || data.photoURL is string)
        && data.headline is string && data.headline.size() <= 120
        && data.bio is string && data.bio.size() <= 1000
        && data.location is string && data.location.size() <= 120
        && data.locationLower is string && data.locationLower == data.location.lower()
        && data.organizations is list && data.organizations.size() <= 10
        && data.education is list && data.education.size() <= 10
        && data.skills is list && data.skills.size() <= 20
        && data.skillsLower is list && data.skillsLower.size() <= 20
        && data.interests is list && data.interests.size() <= 20
        && data.interestsLower is list && data.interestsLower.size() <= 20
        && data.links is map
        && data.isComplete is bool
        && data.hasFounderOrg is bool
        && data.currentOrganizationName is string && data.currentOrganizationName.size() <= 200
        && data.currentTitle is string && data.currentTitle.size() <= 200
        && isValidBatchNumber(data.batchNumber)
        && data.keys().hasOnly(
             ['uid', 'displayName', 'displayNameLower', 'photoURL', 'batchNumber', 'headline',
              'bio', 'location', 'locationLower', 'organizations', 'education', 'skills',
              'skillsLower', 'interests', 'interestsLower', 'links', 'isComplete',
              'hasFounderOrg', 'currentOrganizationName', 'currentTitle', 'createdAt', 'updatedAt']
           );
    }

    match /users/{uid} {
      // A user can read their own record (to see their approval status).
      // An admin can read any record (to review pending accounts).
      allow get: if isSelf(uid) || callerIsAdmin();
      allow list: if callerIsAdmin();

      // First sign-in creates exactly one doc, for yourself, always
      // starting 'pending' and never admin. No client input can bypass
      // this — status and isAdmin are hardcoded requirements here, not
      // read from the client's request body values.
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.isAdmin == false
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'displayName', 'photoURL', 'status', 'isAdmin', 'createdAt', 'updatedAt']
           );

      // Only an admin can change an account's status, and an admin write
      // may ONLY touch status/updatedAt — it can't also grant itself or
      // anyone else isAdmin, and it can't rewrite identity fields.
      allow update: if callerIsAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.isAdmin == resource.data.isAdmin
        && (request.resource.data.status == 'pending'
            || request.resource.data.status == 'approved'
            || request.resource.data.status == 'rejected');

      allow delete: if false;
    }

    match /profiles/{uid} {
      // Phase 3 (Directory): any approved member can now read any OTHER
      // approved member's profile — but only through a query the rules
      // themselves bound to a small page size, never an unbounded
      // client-side dump of the collection. `list` results are evaluated
      // per returned document, so `uid` here is each document's own ID
      // and profileOwnerIsApproved(uid) is checked once per document.
      allow get: if isSelf(uid) || callerIsAdmin()
        || (callerIsApproved() && profileOwnerIsApproved(uid));

      allow list: if callerIsAdmin()
        || (callerIsApproved() && request.query.limit <= 30 && profileOwnerIsApproved(uid));

      allow create: if isSelf(uid) && callerIsApproved()
        && request.resource.data.uid == uid
        && isValidProfileShape(request.resource.data);

      // Admins can also correct a member's profile (e.g. wrong batch),
      // per Phase 2's "Admin/batch moderator controls" — a full batch
      // moderator role scoped to specific batches is Phase 11.
      allow update: if ((isSelf(uid) && callerIsApproved()) || callerIsAdmin())
        && request.resource.data.uid == uid
        && isValidProfileShape(request.resource.data);

      allow delete: if false;
    }

    // Everything else stays deny-by-default until a later phase defines
    // its own narrowly-scoped rules here (see ARCHITECTURE.md's
    // suggested collections list).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
