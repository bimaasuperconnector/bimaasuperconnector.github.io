rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function callerRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function callerHasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerIsSuperAdmin() {
      return callerHasUserDoc() && callerRecord().role == 'super_admin';
    }

    function callerIsBatchAdmin() {
      return callerHasUserDoc() && callerRecord().role == 'batch_admin';
    }

    // Either admin tier — used where "some kind of admin" is enough
    // (e.g. reading protected match data). Batch-scoped write checks use
    // callerIsBatchAdmin() + assignedBatchNumbers directly instead.
    function callerIsAnyAdmin() {
      return callerIsSuperAdmin() || callerIsBatchAdmin();
    }

    // A caller must be an *approved* member (not just signed in) before
    // they can create/edit a profile, register, etc. — this is the
    // authoritative check; ProtectedRoute in the app is UX only.
    function callerIsApproved() {
      return callerHasUserDoc() && callerRecord().status == 'approved';
    }

    // Keep this ceiling in sync with CURRENT_MAX_BATCH_NUMBER in
    // src/lib/batches.ts. null is allowed on profiles (batch not yet
    // selected there) but NOT on users (batch is mandatory at onboarding
    // — see the onboarding revision in FEATURE_SUPERCONNECTOR.md).
    function isValidBatchNumber(n) {
      return n is int && n >= 1 && n <= 43;
    }

    function isValidBatchNumberOrNull(n) {
      return n == null || isValidBatchNumber(n);
    }

    // Phase 2/11 revision (2026-09-13): `contactVisible` is a
    // denormalized, PUBLIC-SAFE subset of profileContacts/{uid} —
    // it contains a key ONLY for a channel the owner has chosen to
    // reveal, and the owner writes it themselves (this is their own
    // choice about their own data, not a security boundary the way
    // approval status is). Never put DOB here — DOB lives ONLY in
    // profileContacts/{uid}, which is owner-only-readable, full stop.
    function isValidContactVisibleMap(m) {
      return m is map
        && m.keys().hasOnly(['phone', 'whatsapp', 'email', 'linkedin'])
        && (!('phone' in m) || (m.phone is string && m.phone.size() <= 60))
        && (!('whatsapp' in m) || (m.whatsapp is string && m.whatsapp.size() <= 60))
        && (!('email' in m) || (m.email is string && m.email.size() <= 200))
        && (!('linkedin' in m) || (m.linkedin is string && m.linkedin.size() <= 300));
    }

    function isValidProfileShape(data) {
      // Phase 2/11 revision: `displayName` is now directly owner-edited
      // in the Profile form (a real "Name" field, seeded once from the
      // onboarding name but freely editable afterward — e.g. a surname
      // change after marriage). It is no longer silently overwritten
      // from the Google account's live displayName at every save. The
      // non-empty check is new for the same reason `users.create`
      // already requires a non-empty name at onboarding: a blank name
      // is exactly the "Unnamed alum" bug reported against the
      // directory/Open-to-Work pages, so the shape now refuses to save
      // a blank one rather than allowing it and letting the UI fall
      // back to a placeholder string.
      return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 200
        && data.displayNameLower is string && data.displayNameLower == data.displayName.lower()
        && (data.photoURL == null || data.photoURL is string)
        && data.headline is string && data.headline.size() <= 120
        && data.bio is string && data.bio.size() <= 1000
        && data.location is string && data.location.size() <= 120
        && data.locationLower is string && data.locationLower == data.location.lower()
        && data.organizations is list && data.organizations.size() <= 10
        && data.education is list && data.education.size() <= 10
        && data.skills is list && data.skills.size() <= 20
        && data.skillsLower is list && data.skillsLower.size() <= 20
        && data.interests is list && data.interests.size() <= 20
        && data.interestsLower is list && data.interestsLower.size() <= 20
        && data.networkingPurpose is list && data.networkingPurpose.size() <= 6
        && data.networkingPurpose.hasOnly(
             ['mentorship', 'job_search', 'hiring', 'collaboration', 'industry_insights', 'reconnecting']
           )
        && data.links is map
        && data.isComplete is bool
        && data.openToWork is bool
        && data.openToWorkRoles is list && data.openToWorkRoles.size() <= 10
        && data.openToWorkNote is string && data.openToWorkNote.size() <= 500
        && data.hasFounderOrg is bool
        && data.currentOrganizationName is string && data.currentOrganizationName.size() <= 200
        && data.currentTitle is string && data.currentTitle.size() <= 200
        && isValidContactVisibleMap(data.contactVisible)
        // Denormalized from the caller's OWN approval status at save
        // time. Always required true here (create/update both require
        // callerIsApproved() independently), which makes directory
        // `list` queries a cheap same-document field check instead of a
        // cross-collection get() per result — see the Phase 5-adjacent
        // bugfix notes in FEATURE_SUPERCONNECTOR.md for why the old
        // cross-collection approach caused a total directory outage for
        // non-admin users the moment ANY one profile's owner had an
        // inconsistent status. Known tradeoff: if an admin revokes an
        // already-approved member later, their profile can stay
        // directory-visible (stale) until next resaved — accepted, see
        // notes.
        && data.approved == true
        && isValidBatchNumberOrNull(data.batchNumber)
        && data.keys().hasOnly(
             ['uid', 'displayName', 'displayNameLower', 'photoURL', 'batchNumber', 'headline',
              'bio', 'location', 'locationLower', 'organizations', 'education', 'skills',
              'skillsLower', 'interests', 'interestsLower', 'networkingPurpose', 'links',
              'isComplete', 'openToWork', 'openToWorkRoles', 'openToWorkNote', 'hasFounderOrg',
              'currentOrganizationName', 'currentTitle', 'approved', 'contactVisible',
              'createdAt', 'updatedAt']
           );
    }

    function isValidRegistrationShape(data) {
      return data.uid is string
        && data.cycleId is string
        && data.cycleId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && data.slot in ['saturday', 'sunday', 'both']
        && data.mode in ['one_to_one', 'small_circle']
        && data.keys().hasOnly(['uid', 'cycleId', 'slot', 'mode', 'createdAt', 'updatedAt']);
    }

    match /users/{uid} {
      // A user can read their own record. Any admin tier can read any
      // record (needed for the approval console).
      allow get: if isSelf(uid) || callerIsAnyAdmin();
      // Kept intentionally simple (no batch-scoping in the rule itself)
      // to avoid Firestore's "queries are all or nothing" trap: a rule
      // that filtered per-document by comparing to the caller's
      // assigned batches would fail the ENTIRE query the moment ANY
      // pending user outside that scope existed. Batch-scoping is
      // enforced at the point that actually matters — the approve/
      // reject WRITE below, which is a safe single-document check, not
      // a query. The admin console additionally filters what it
      // DISPLAYS to a batch_admin as a UX convenience, not a security
      // boundary. Documented tradeoff: a batch_admin can technically
      // list pending users outside their batch (name/batch/note only,
      // no sensitive data) via a direct API call — accepted, since
      // batch_admin is already a trusted, owner-appointed role.
      allow list: if callerIsAnyAdmin();

      // Onboarding: first sign-in does NOT auto-create this document
      // anymore (see the Phase 1 revision notes). The member must
      // submit their name, batch, and an optional note. Always starts
      // 'pending' / role 'alumni' / no assigned batches — none of that
      // is client-choosable no matter what the client sends.
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'alumni'
        && request.resource.data.assignedBatchNumbers == []
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 200
        && isValidBatchNumber(request.resource.data.batchNumber)
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'displayName', 'photoURL', 'batchNumber', 'note', 'status',
              'role', 'assignedBatchNumbers', 'createdAt', 'updatedAt']
           );

      // Approve/reject (status-only, batch-scoped for batch_admin) OR
      // role management (super_admin only, role/batches-only). Combined
      // into one OR rather than two separate `match /users/{uid}`
      // blocks, to avoid relying on how Firestore merges multiple match
      // blocks for the same path — safer to be explicit here.
      allow update: if
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.assignedBatchNumbers == resource.data.assignedBatchNumbers
          && (request.resource.data.status == 'pending'
              || request.resource.data.status == 'approved'
              || request.resource.data.status == 'rejected')
          && (
            callerIsSuperAdmin()
            || (callerIsBatchAdmin()
                && resource.data.batchNumber != null
                && resource.data.batchNumber in callerRecord().assignedBatchNumbers)
          )
        )
        ||
        (
          callerIsSuperAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'assignedBatchNumbers', 'updatedAt'])
          && request.resource.data.role in ['alumni', 'batch_admin', 'super_admin']
          && request.resource.data.assignedBatchNumbers is list
          && request.resource.data.status == resource.data.status
        );

      allow delete: if false;
    }

    match /profiles/{uid} {
      // See isValidProfileShape's comment on `approved` for why this is
      // a same-document field check, not a cross-collection lookup.
      allow get: if isSelf(uid) || callerIsAnyAdmin() || (callerIsApproved() && resource.data.approved == true);
      allow list: if callerIsAnyAdmin()
        || (callerIsApproved() && request.query.limit <= 30);

      allow create: if isSelf(uid) && callerIsApproved()
        && request.resource.data.uid == uid
        && isValidProfileShape(request.resource.data);

      allow update: if ((isSelf(uid) && callerIsApproved()) || callerIsAnyAdmin())
        && request.resource.data.uid == uid
        && isValidProfileShape(request.resource.data);

      allow delete: if false;
    }

    // Phase 2/11 revision (2026-09-13): private contact channels + DOB.
    function isValidProfileContactShape(data) {
      return (data.dob == null || (data.dob is string && data.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && data.phoneNumber is string && data.phoneNumber.size() <= 40
        && data.whatsappNumber is string && data.whatsappNumber.size() <= 40
        && data.contactEmail is string && data.contactEmail.size() <= 200
        && data.linkedinUrl is string && data.linkedinUrl.size() <= 300
        && data.visibility is map
        && data.visibility.keys().hasOnly(['phone', 'whatsapp', 'email', 'linkedin'])
        && data.visibility.phone is bool
        && data.visibility.whatsapp is bool
        && data.visibility.email is bool
        && data.visibility.linkedin is bool
        && data.keys().hasOnly(
             ['uid', 'dob', 'phoneNumber', 'whatsappNumber', 'contactEmail', 'linkedinUrl',
              'visibility', 'createdAt', 'updatedAt']
           );
    }

    // Raw contact channels (phone/WhatsApp/email/LinkedIn) AND date of
    // birth. Owner-only, with NO admin read path at all — deliberately
    // stricter than every other collection in this file. Per the
    // explicit product requirement: date of birth "will be used only
    // to send Happy Birthday greetings" (a future automation job, via
    // the Admin SDK, which bypasses these Rules entirely — nothing here
    // needs to grant it client-level read access) and "is only visible
    // to the user, no one else." The PUBLIC-safe subset a member
    // chooses to reveal is denormalized onto profiles/{uid}.contactVisible
    // instead (see isValidContactVisibleMap above) so Directory/Open to
    // Work reads never need a second document per profile shown — this
    // document is read only by its own owner, on their own Profile page.
    match /profileContacts/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow create: if isSelf(uid) && callerIsApproved()
        && request.resource.data.uid == uid
        && isValidProfileContactShape(request.resource.data);
      allow update: if isSelf(uid) && callerIsApproved()
        && request.resource.data.uid == uid
        && isValidProfileContactShape(request.resource.data);
      allow delete: if false;
    }

    // Phase 7 finally closes the gap Phase 4 explicitly deferred: a
    // cycle whose connectionCycles doc says registration is no longer
    // open rejects new registrations/changes. Defaults to ALLOWING if
    // no cycle doc exists yet (e.g. before the cycle-state job has ever
    // run for a brand new cycleId) — a chicken-and-egg safeguard, not a
    // loophole, since the cycle-state job creates the doc as
    // 'registration_open' the first time it sees a new cycle anyway.
    function registrationIsOpenForCycle(cycleId) {
      return !exists(/databases/$(database)/documents/connectionCycles/$(cycleId))
        || get(/databases/$(database)/documents/connectionCycles/$(cycleId)).data.status == 'registration_open';
    }

    match /connectionRegistrations/{registrationId} {
      // `resource == null` handles a `get` on a registration that
      // doesn't exist yet (e.g. a member's first-ever visit to the
      // SuperConnector page, before they've registered for anything) —
      // without this, `resource.data.uid` errors on a null resource for
      // any non-admin caller and the read is wrongly denied. Real bug,
      // fixed here.
      allow get: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || callerIsAnyAdmin());
      allow list: if callerIsAnyAdmin();

      allow create: if callerIsApproved()
        && request.resource.data.uid == request.auth.uid
        && registrationId == (request.resource.data.cycleId + '_' + request.auth.uid)
        && registrationIsOpenForCycle(request.resource.data.cycleId)
        && isValidRegistrationShape(request.resource.data);

      allow update: if callerIsApproved()
        && resource.data.uid == request.auth.uid
        && registrationIsOpenForCycle(resource.data.cycleId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slot', 'mode', 'updatedAt'])
        && isValidRegistrationShape(request.resource.data);

      // Withdrawal is always allowed regardless of cycle status —
      // someone should always be able to remove themselves from
      // consideration, even after registration nominally "closed," as
      // long as matching hasn't produced results yet. If this becomes a
      // real problem once real usage exists, revisit.
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Phase 5 (Matching engine): written ONLY by trusted server-side
    // automation via the Firebase Admin SDK, not subject to these Rules
    // at all — every client write path is deny-all, including for
    // admins. See SECURITY_AND_TESTING.md: "Client cannot create
    // arbitrary match records... Pair history is protected."

    match /matches/{matchId} {
      allow get: if callerIsAnyAdmin();
      allow list: if callerIsAnyAdmin();
      allow create, update, delete: if false;
    }

    match /matchParticipants/{matchParticipantId} {
      allow get: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || callerIsAnyAdmin());
      // Lets a member discover their OWN match assignments (needed for
      // the Phase 6 feedback flow — "which matches am I part of, so I
      // know who to ask for feedback about"). Safe from the "queries
      // are all or nothing" trap that bit profiles.list earlier: this
      // check depends ONLY on the same document's own `uid` field, not
      // a cross-collection lookup, so as long as the CLIENT issues the
      // query with a matching `where('uid', '==', <their own uid>)`
      // filter, Firestore can structurally prove every potential result
      // satisfies the rule. See feedbackRepository.ts.
      allow list: if callerIsAnyAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /pairHistory/{pairId} {
      allow get: if callerIsAnyAdmin();
      allow list: if callerIsAnyAdmin();
      allow create, update, delete: if false;
    }

    // Phase 6 (Feedback & Connection Meter).

    function callerWasMatchedWith(matchId, aboutUid) {
      return exists(/databases/$(database)/documents/matchParticipants/$(matchId + '_' + request.auth.uid))
        && aboutUid in get(/databases/$(database)/documents/matchParticipants/$(matchId + '_' + request.auth.uid)).data.otherParticipantUids;
    }

    function isValidFeedbackShape(data) {
      return data.matchId is string
        && data.fromUid is string
        && data.aboutUid is string
        && data.cycleId is string
        && data.cycleId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && data.sentiment in ['great', 'okay', 'not_good', 'skip']
        && data.keys().hasOnly(['matchId', 'fromUid', 'aboutUid', 'cycleId', 'sentiment', 'createdAt', 'updatedAt']);
    }

    match /feedback/{feedbackId} {
      // A member can read feedback THEY GAVE (to see their own history);
      // never feedback ABOUT them — same "hidden" spirit as the
      // Connection Meter itself. `resource == null` guard for the same
      // reason as connectionRegistrations/matchParticipants above: a
      // client checking "have I already given feedback about X" before
      // any record exists must not error.
      allow get: if isSignedIn() && (resource == null || resource.data.fromUid == request.auth.uid || callerIsAnyAdmin());
      allow list: if callerIsAnyAdmin();

      // The document ID is always `${matchId}_${fromUid}_${aboutUid}`,
      // and `callerWasMatchedWith` independently verifies (via the
      // caller's OWN matchParticipants record — a single-document check,
      // not a list, so it's not at risk of the "queries are all or
      // nothing" issue documented elsewhere in this file) that the
      // caller was actually matched with the person they're leaving
      // feedback about. A client cannot leave feedback about someone it
      // was never matched with, and cannot leave feedback as anyone but
      // itself.
      allow create: if callerIsApproved()
        && request.resource.data.fromUid == request.auth.uid
        && feedbackId == (request.resource.data.matchId + '_' + request.auth.uid + '_' + request.resource.data.aboutUid)
        && callerWasMatchedWith(request.resource.data.matchId, request.resource.data.aboutUid)
        && isValidFeedbackShape(request.resource.data);

      // A member can change their mind before Phase 7's automation
      // processes feedback (there's no "window closed" state to check
      // against yet — same honest non-enforcement as Phase 4's
      // registration deadline). Can only ever touch sentiment, never
      // reassign who the feedback is about or which match it belongs to.
      allow update: if callerIsApproved()
        && resource.data.fromUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sentiment', 'updatedAt'])
        && isValidFeedbackShape(request.resource.data);

      allow delete: if false;
    }

    // The hidden score itself. Written ONLY by trusted server-side
    // automation (Phase 7's feedback/score job) via the Admin SDK —
    // deny-all for every client write, and deny-all reads too, including
    // for the member the score belongs to: "hidden" is read literally
    // here, not just "not client-editable." Admins can read for internal
    // visibility/debugging.
    match /connectionMeters/{uid} {
      allow get: if callerIsAnyAdmin();
      allow list: if callerIsAnyAdmin();
      allow create, update, delete: if false;
    }

    // Phase 7 (Monthly automation).

    // Not private data — the meeting dates for a cycle are already
    // computed and shown client-side with no auth at all (Phase 4).
    // Readable by any signed-in user; only the cycle-state job (Admin
    // SDK) ever writes it.
    match /connectionCycles/{cycleId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Per-user notification feed. Path-scoped to the owner, which is
    // inherently safe (no cross-document dependency, no "all or
    // nothing" risk) — the wildcard `uid` IS the ownership check.
    // Only automation (Admin SDK) creates notifications. No
    // mark-as-read update path yet — the Notifications page ships as
    // read-only this phase; a scoped update (touching only `read`)
    // can be added once that UX is actually wanted.
    match /notifications/{uid}/items/{notificationId} {
      allow get: if isSelf(uid) || callerIsAnyAdmin();
      allow list: if isSelf(uid) || callerIsAnyAdmin();
      allow create, update, delete: if false;
    }

    // Automation run history. Admin-only visibility; only automation
    // (Admin SDK) writes it.
    match /auditLogs/{logId} {
      allow get: if callerIsAnyAdmin();
      allow list: if callerIsAnyAdmin();
      allow create, update, delete: if false;
    }

    // Includes the automation run-lock document (systemConfig/automationLock)
    // and any future global config. Admin-only visibility; only
    // automation (Admin SDK) writes it.
    match /systemConfig/{configId} {
      allow get: if callerIsAnyAdmin();
      allow list: if callerIsAnyAdmin();
      allow create, update, delete: if false;
    }

    // Phase 9 (Jobs).

    function isValidJobShape(data) {
      return data.postedByUid is string
        && data.postedByDisplayName is string
        && data.company is string && data.company.size() > 0 && data.company.size() <= 200
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.location is string && data.location.size() > 0 && data.location.size() <= 200
        && data.employmentType in ['full_time', 'part_time', 'contract', 'internship', 'freelance']
        && data.urgency in ['urgent', 'standard']
        && data.description is string && data.description.size() > 0 && data.description.size() <= 3000
        && data.skills is list && data.skills.size() <= 20
        && data.experienceLevel is string && data.experienceLevel.size() <= 200
        && data.contactPerson is string && data.contactPerson.size() > 0 && data.contactPerson.size() <= 200
        && data.contactDetails is string && data.contactDetails.size() > 0 && data.contactDetails.size() <= 300
        && data.applicationMethod is string && data.applicationMethod.size() > 0 && data.applicationMethod.size() <= 500
        && data.expirationDate is timestamp
        && data.status in ['pending', 'approved', 'rejected', 'archived']
        && data.keys().hasOnly(
             ['postedByUid', 'postedByDisplayName', 'company', 'title', 'location', 'employmentType',
              'urgency', 'description', 'skills', 'experienceLevel', 'contactPerson', 'contactDetails',
              'applicationMethod', 'expirationDate', 'status', 'createdAt', 'updatedAt']
           );
    }

    match /jobs/{jobId} {
      // Approved postings are visible to any approved member (the
      // active jobs board); a poster can always see their own
      // regardless of status (to track pending/rejected/archived);
      // admins can see everything (moderation queue). Both `list`
      // branches below match the query filter structurally
      // (status=='approved', or postedByUid==caller) — the same safe
      // "author == uid" pattern used elsewhere in this file, not the
      // fragile cross-collection pattern that caused the 2026-09-08
      // directory outage.
      allow get: if (
        callerIsApproved()
        && (resource.data.status == 'approved' || resource.data.postedByUid == request.auth.uid)
      ) || callerIsAnyAdmin();
      allow list: if callerIsAnyAdmin()
        || (callerIsApproved()
            && (resource.data.status == 'approved' || resource.data.postedByUid == request.auth.uid));

      allow create: if callerIsApproved()
        && request.resource.data.postedByUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.expirationDate > request.time
        && isValidJobShape(request.resource.data);

      // Either the poster edits their own content (status can't be
      // touched this way — moderation is a separate, admin-only path
      // below) OR an admin moderates (status/updatedAt only, can't
      // rewrite the posting's content while doing so).
      allow update: if (
        callerIsApproved()
        && resource.data.postedByUid == request.auth.uid
        && request.resource.data.postedByUid == request.auth.uid
        && request.resource.data.status == resource.data.status
        && isValidJobShape(request.resource.data)
      ) || (
        callerIsAnyAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'approved', 'rejected', 'archived']
      );

      // A poster can withdraw their own listing at any time; an admin
      // can remove any listing (e.g. a policy violation).
      allow delete: if (isSignedIn() && resource.data.postedByUid == request.auth.uid) || callerIsAnyAdmin();
    }

    // Phase 11 (Admin, moderators & analytics) — reporting/moderation,
    // per FEATURE_SUPERCONNECTOR.md's Phase 11 scope note added
    // 2026-09-08 ("ability for any member to report posts/events/etc.,
    // with super_admin tooling to review and act on reports"). Jobs
    // (Phase 9) is the only reportable content that exists so far;
    // 'job' is the only valid targetType until Events (Phase 13) ships.
    function isValidReportShape(data) {
      return data.reporterUid is string
        // 'event' added in Phase 13 — Phase 11's completion log
        // explicitly deferred this ("reports against Events (blocked
        // on Phase 13)"); it isn't blocked anymore.
        && data.targetType in ['job', 'event']
        && data.targetId is string && data.targetId.size() > 0
        && data.reason in ['spam', 'inappropriate', 'scam', 'other']
        && data.note is string && data.note.size() <= 500
        && data.status in ['open', 'resolved', 'dismissed']
        && data.keys().hasOnly(
             ['reporterUid', 'targetType', 'targetId', 'reason', 'note', 'status', 'createdAt', 'updatedAt']
           );
    }

    match /reports/{reportId} {
      // A reporter can read their own report (to see it was received);
      // never someone else's — only an admin sees the full queue.
      allow get: if callerIsAnyAdmin()
        || (isSignedIn() && resource.data.reporterUid == request.auth.uid);
      allow list: if callerIsAnyAdmin()
        || (callerIsApproved() && resource.data.reporterUid == request.auth.uid);

      allow create: if callerIsApproved()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && isValidReportShape(request.resource.data);

      // Admin resolves/dismisses — status/updatedAt only, can never
      // rewrite the report's substance (reporter, target, reason, note)
      // while moderating it.
      allow update: if callerIsAnyAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['open', 'resolved', 'dismissed'];

      allow delete: if false;
    }

    // Phase 13 (Events & meetups).
    //
    // An event is visible to exactly the people its targeting says it
    // should be: everyone, a set of batches, a city, or a hand-picked
    // list of uids — plus always its own organizer and any admin.
    // `canSeeEvent()` below independently RECOMPUTES the caller's own
    // batch number / city from their own profile document via get() —
    // it never trusts a value the client claims in the query itself.
    //
    // Safety re: the "queries are all or nothing" trap documented at
    // the top of this file (see the 2026-09-08 bugfix notes in
    // FEATURE_SUPERCONNECTOR.md): every get() this function performs
    // is a lookup of the CALLER's OWN profile — the exact same document
    // for every potential result document in a given query execution,
    // never a lookup that varies per result. That's the same reasoning
    // already relied on throughout this file for callerIsApproved(),
    // callerIsAnyAdmin(), and callerRecord() inside other `list` rules
    // (e.g. profiles.list, jobs.list) — a CONSTANT per-request read,
    // not the PER-RESULT variability that actually caused Bug 1.
    function callerHasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function callerBatchNumber() {
      return callerHasProfile()
        ? get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.batchNumber
        : null;
    }

    function callerCityLower() {
      return callerHasProfile()
        ? get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.locationLower
        : '';
    }

    function canSeeEvent(data) {
      return data.targetType == 'everyone'
        || (data.targetType == 'batch' && callerBatchNumber() != null && callerBatchNumber() in data.targetBatchNumbers)
        || (data.targetType == 'city' && callerCityLower() != '' && callerCityLower() == data.targetCityLower)
        || (data.targetType == 'selected' && request.auth.uid in data.targetUids)
        || data.organizerUid == request.auth.uid;
    }

    // Keep targetBatchNumbers' cap in sync with CURRENT_MAX_BATCH_NUMBER
    // (see isValidBatchNumber above) and targetUids' cap with
    // MAX_TARGET_UIDS in src/lib/events.ts.
    function isValidEventTargeting(data) {
      return data.targetType in ['everyone', 'batch', 'city', 'selected']
        && data.targetBatchNumbers is list && data.targetBatchNumbers.size() <= 43
        && data.targetCityLower is string && data.targetCityLower.size() <= 120
        && data.targetUids is list && data.targetUids.size() <= 50
        && (data.targetType == 'batch' ? data.targetBatchNumbers.size() > 0 : data.targetBatchNumbers.size() == 0)
        && (data.targetType == 'city' ? data.targetCityLower.size() > 0 : data.targetCityLower == '')
        && (data.targetType == 'selected' ? data.targetUids.size() > 0 : data.targetUids.size() == 0);
    }

    // Core editable fields only — organizer identity, targeting, and
    // every automation-only field (calendarEventId, meetLink,
    // syncedAttendeeUids — written solely by the Admin SDK, see
    // automation/src/eventsCalendarJob.ts) are deliberately validated
    // NOWHERE in this function. The update rule below restricts an
    // organizer's write to ONLY the keys checked here via
    // diff().affectedKeys().hasOnly(...), so those other fields are
    // structurally guaranteed unchanged rather than needing to be
    // re-validated on every edit (which would otherwise require this
    // function to know about fields only automation ever sets).
    function isValidEventCoreFields(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 3000
        && data.format in ['virtual', 'physical']
        && data.location is string && data.location.size() <= 200
        && (data.format == 'physical' ? data.location.size() > 0 : true)
        && data.virtualNote is string && data.virtualNote.size() <= 300
        && data.startTime is timestamp
        && data.endTime is timestamp
        && data.endTime > data.startTime
        && (data.rsvpDeadline == null || (data.rsvpDeadline is timestamp && data.rsvpDeadline <= data.startTime))
        && (data.capacity == null || (data.capacity is int && data.capacity >= 1 && data.capacity <= 1000))
        && data.status in ['scheduled', 'cancelled'];
    }

    // Full shape, create-time only. Deliberately excludes calendarEventId
    // / calendarEventHtmlLink / meetLink / syncedAttendeeUids from
    // hasOnly() below — a client-created event must never arrive with
    // those already set; only the Admin SDK (bypassing these Rules
    // entirely) ever writes them, after creation.
    function isValidEventShape(data) {
      return data.organizerUid is string
        && data.organizerDisplayName is string && data.organizerDisplayName.size() <= 200
        && isValidEventCoreFields(data)
        && isValidEventTargeting(data)
        && data.keys().hasOnly(
             ['organizerUid', 'organizerDisplayName', 'title', 'description', 'format', 'location',
              'virtualNote', 'startTime', 'endTime', 'rsvpDeadline', 'capacity', 'targetType',
              'targetBatchNumbers', 'targetCityLower', 'targetUids', 'status', 'createdAt', 'updatedAt']
           );
    }

    match /events/{eventId} {
      // `resource == null` guard for the same reason as
      // connectionRegistrations/matchParticipants/feedback above — a
      // client checking "does event X still exist" before RSVPing must
      // not error on a not-yet/no-longer-existing document.
      allow get: if callerIsAnyAdmin() || (callerIsApproved() && (resource == null || canSeeEvent(resource.data)));
      allow list: if callerIsAnyAdmin() || (callerIsApproved() && canSeeEvent(resource.data));

      allow create: if callerIsApproved()
        && request.resource.data.organizerUid == request.auth.uid
        && request.resource.data.status == 'scheduled'
        && request.resource.data.startTime > request.time
        && isValidEventShape(request.resource.data);

      // Organizer edit: restricted via diff().affectedKeys().hasOnly()
      // to exactly the core fields isValidEventCoreFields() checks —
      // organizerUid/targeting/automation fields are therefore
      // structurally unchanged by this path, not just "not intended to
      // change." Admin moderation is a separate, narrower branch
      // (status/updatedAt only), same split-update-path pattern as
      // jobs.update.
      allow update: if (
        callerIsApproved()
        && resource.data.organizerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['title', 'description', 'format', 'location', 'virtualNote', 'startTime', 'endTime',
              'rsvpDeadline', 'capacity', 'status', 'updatedAt']
           )
        && isValidEventCoreFields(request.resource.data)
      ) || (
        callerIsAnyAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['scheduled', 'cancelled']
      );

      // Organizer or admin, unconditionally — same posture as
      // jobs.delete. The UI steers organizers toward cancelEvent()
      // instead once RSVPs exist (see eventsRepository.ts), but this
      // isn't enforced here: Rules can't cheaply check "are there zero
      // RSVPs" without a count() query, and count() aggregates can't be
      // used as a Rules condition at all.
      allow delete: if (isSignedIn() && resource.data.organizerUid == request.auth.uid) || callerIsAnyAdmin();
    }

    function isValidEventRsvpShape(data) {
      return data.eventId is string && data.eventId.size() > 0
        && data.uid is string
        && data.organizerUid is string
        && data.status in ['attending', 'waitlisted', 'cancelled']
        && data.keys().hasOnly(['eventId', 'uid', 'organizerUid', 'status', 'respondedAt', 'updatedAt']);
    }

    function eventOrganizerUid(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.organizerUid;
    }

    function eventStatus(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.status;
    }

    function eventRsvpDeadlineOk(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.rsvpDeadline == null
        || request.time < get(/databases/$(database)/documents/events/$(eventId)).data.rsvpDeadline;
    }

    match /eventRsvps/{rsvpId} {
      allow get: if isSignedIn()
        && (resource == null
            || resource.data.uid == request.auth.uid
            || resource.data.organizerUid == request.auth.uid
            || callerIsAnyAdmin());

      // Three independent, structurally-safe branches — none needs a
      // per-result cross-collection check that could vary across a
      // single query's potential results:
      // 1. A member listing their OWN RSVPs (`where('uid','==',uid)`) —
      //    same-document field, exactly the matchParticipants.list
      //    pattern from Phase 6.
      // 2. An organizer listing attendees for ONE event
      //    (`where('eventId','==',X).where('organizerUid','==',uid)`)
      //    — also same-document (organizerUid is denormalized onto
      //    every RSVP at creation — see eventRsvpsRepository.ts),
      //    independently re-verified against the real event document
      //    at CREATE time below, so a client cannot forge it.
      // 3. Anyone who can see event X checking how many people are
      //    `attending` (the capacity/"spots left" count() query) —
      //    `resource.data.eventId` is fixed to whatever single eventId
      //    the query itself filtered on, so the get() below looks up
      //    the SAME event document for every potential result in that
      //    one query execution, not a value that varies per result.
      allow list: if callerIsAnyAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || (isSignedIn() && resource.data.organizerUid == request.auth.uid)
        || (callerIsApproved() && canSeeEvent(get(/databases/$(database)/documents/events/$(resource.data.eventId)).data));

      allow create: if callerIsApproved()
        && request.resource.data.uid == request.auth.uid
        && rsvpId == (request.resource.data.eventId + '_' + request.auth.uid)
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && eventStatus(request.resource.data.eventId) == 'scheduled'
        && request.resource.data.organizerUid == eventOrganizerUid(request.resource.data.eventId)
        && eventRsvpDeadlineOk(request.resource.data.eventId)
        && request.resource.data.status in ['attending', 'waitlisted']
        && isValidEventRsvpShape(request.resource.data);

      // A member can always cancel their own RSVP. Re-activating
      // (attending/waitlisted, e.g. changing their mind back) is only
      // allowed while the event is still scheduled and before its RSVP
      // deadline — same spirit as connectionRegistrations, but RSVP
      // withdrawal itself is handled by `delete` below, not this path.
      allow update: if callerIsApproved()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['attending', 'waitlisted', 'cancelled']
        && (request.resource.data.status == 'cancelled'
            || (eventStatus(resource.data.eventId) == 'scheduled' && eventRsvpDeadlineOk(resource.data.eventId)));

      // Withdrawal is always allowed regardless of event status — same
      // posture as connectionRegistrations.delete.
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Everything else stays deny-by-default until a later phase defines
    // its own narrowly-scoped rules here (see ARCHITECTURE.md's
    // suggested collections list).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
